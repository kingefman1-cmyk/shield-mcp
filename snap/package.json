{
  "name": "@caelaralabs/shield-snap",
  "version": "0.1.0",
  "description": "Caelara Shield transaction insights for MetaMask: local calldata decoding plus optional remote token and destination screening. Heuristic screening — will miss attacks.",
  "keywords": [
    "metamask",
    "snap",
    "transaction-insights",
    "security",
    "approvals"
  ],
  "homepage": "https://caelaralabs.com/shield/",
  "bugs": {
    "url": "https://github.com/kingefman1-cmyk/shield-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingefman1-cmyk/shield-mcp.git"
  },
  "license": "MIT",
  "author": "Caelara Labs <ops@caelaralabs.com>",
  "main": "./dist/bundle.js",
  "files": [
    "dist/",
    "snap.manifest.json",
    "images/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "mm-snap build",
    "manifest": "mm-snap manifest",
    "manifest:fix": "mm-snap manifest --fix",
    "eval": "mm-snap eval",
    "serve": "mm-snap serve",
    "start": "mm-snap watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "mm-snap build && mm-snap manifest"
  },
  "dependencies": {
    "@metamask/snaps-sdk": "12.1.0"
  },
  "engines": {
    "node": "^20 || >=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@metamask/post-message-stream": "^10.0.0",
    "@metamask/snaps-cli": "^8.4.1",
    "@metamask/snaps-controllers": "22.0.1",
    "@metamask/snaps-jest": "10.2.2",
    "@types/react": "18.2.4",
    "@types/react-dom": "18.2.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.7.3"
  },
  "overrides": {
    "@metamask/snaps-simulation": "4.3.2",
    "@metamask/snaps-execution-environments": "11.3.3",
    "@metamask/snaps-controllers": "22.0.1"
  }
}
